# Local Azure and Foundry credentials — copy from *.env.example templates,
# fill in real values, and never commit them.
*.env

# Deployment-specific Bicep parameter files (contain tenant/subscription/environment
# values via readEnvironmentVariable()). Keep *.bicepparam out of source control;
# only the .bicep templates themselves are tracked.
*.bicepparam

# OS and editor junk.
.DS_Store

# Python bytecode cache — can embed literal strings from source at build time.
__pycache__/
*.pyc

# Local credential/token caches, in case a non-macOS fallback ever writes one
# next to the scripts (the current get-gateway-token.py uses macOS Keychain
# only, but this is a defensive backstop).
*.token
*.msal_cache*
