    "appInsightsName": "[format('appi-{0}-{1}', parameters('baseName'), parameters('environmentName'))]",
    "apimServiceName": "[format('apim-{0}-{1}', parameters('baseName'), parameters('environmentName'))]",
    "keyVaultName": "[format('kv-{0}-{1}', parameters('environmentName'), take(uniqueString(resourceGroup().id), 10))]"
  },
  "resources": [
    {
