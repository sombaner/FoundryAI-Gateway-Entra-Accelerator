              "version": "0.33.93.31351",
              "templateHash": "7282378437269051004"
            }
          },
          "parameters": {
            "apimServiceName": {
              "type": "string",
              "metadata": {
                "description": "Name of the existing APIM service to attach these resources to."
              }
            },
            "foundryEndpointUrl": {
              "type": "string",
              "metadata": {
                "description": "Existing Foundry Anthropic Messages API base URL, up to and including the /v1 segment, e.g. https://<foundry-resource>.services.ai.azure.com/anthropic/v1 (APIM appends the operation path, /messages, to this base). Foundry is pre-existing and is never created/modified by this template."
              }
            },
            "keyVaultUri": {
              "type": "string",
              "metadata": {
                "description": "Key Vault URI (with trailing slash) holding the Foundry API key secret. Supplied by the keyvault.bicep module output."
              }
            },
            "foundryApiKeySecretName": {
              "type": "string",
              "defaultValue": "foundry-api-key",
              "metadata": {
                "description": "Name of the Key Vault secret holding the Foundry API key."
              }
            },
            "approvedModelName": {
              "type": "string",
              "metadata": {
                "description": "Comma-separated (no spaces) list of model deployment names that Claude Desktop/Code may send in the \"model\" field to be allowed through the gateway allowlist."
              }
            },
            "backendForwardTimeoutSeconds": {
              "type": "int",
              "defaultValue": 300,
              "minValue": 60,
              "maxValue": 600,
              "metadata": {
                "description": "APIM forward timeout, in seconds, for long-running inference/streaming calls (5-10 minutes per Section 5.4)."
              }
            },
            "includeModelsOperation": {
              "type": "bool",
              "defaultValue": true,
              "metadata": {
                "description": "Whether to also expose GET /v1/models for client discovery."
              }
            }
          },
          "variables": {
            "$fxv#0": "<!--\n  Claude Governance MVP — /v1/messages operation policy\n  Source of truth: mvp-architecture/Claude-Governance-MVP-Architecture.docx, Section 5.3\n  Order matters. Do not remove or reorder steps without updating the design doc.\n  {{entra-tenant-id}}, {{gateway-api-client-id}}, {{cowork-client-id}},\n  {{approved-model-name}}, {{foundry-api-key}} are APIM named values, resolved\n  by APIM at request time — do not replace with literals.\n\n  BACKEND AUTH: the Foundry/Anthropic resource lives in a separate Entra\n  tenant with no federation configured, so managed-identity auth to the\n  backend is not possible. {{foundry-api-key}} is a Key-Vault-backed secret\n  named value (modules/keyvault.bicep + modules/apim-policy.bicep) — the raw\n  key is never sent by the client and never stored in this file.\n-->\n<policies>\n  <inbound>\n    <base />\n\n    <!-- 5.3.1 Entra access-token validation -->\n    <validate-azure-ad-token tenant-id=\"{{entra-tenant-id}}\"\n        header-name=\"Authorization\" failed-validation-httpcode=\"401\"\n        failed-validation-error-message=\"Missing or invalid access token.\"\n        output-token-variable-name=\"gatewayJwt\">\n      <audiences>\n        <audience>{{gateway-api-client-id}}</audience>\n      </audiences>\n      <client-application-ids>\n        <application-id>{{cowork-client-id}}</application-id>\n      </client-application-ids>\n      <required-claims>\n        <claim name=\"scp\" match=\"any\" separator=\" \">\n          <value>Inference.Invoke</value>\n        </claim>\n      </required-claims>\n    </validate-azure-ad-token>\n    <set-variable name=\"userOid\" value=\"@{\n      var jwt = (Jwt)context.Variables[&quot;gatewayJwt&quot;];\n      return jwt.Claims.GetValueOrDefault(&quot;oid&quot;, &quot;&quot;);\n    }\" />\n\n        <!-- 5.3.2 Model allowlist ({{approved-model-name}} is a comma-separated\n          list of approved model deployment names, no spaces) -->\n    <set-variable name=\"requestedModel\" value=\"@{\n      var body = context.Request.Body.As&lt;JObject&gt;(preserveContent: true);\n      return (string)body[&quot;model&quot;] ?? &quot;&quot;;\n    }\" />\n    <choose>\n      <when condition=\"@{\n          var approved = &quot;{{approved-model-name}}&quot;.Split(',');\n          var requested = (string)context.Variables[&quot;requestedModel&quot;];\n          return !approved.Contains(requested);\n      }\">\n        <return-response>\n          <set-status code=\"403\" reason=\"Model Not Entitled\" />\n          <set-body>{\"type\":\"error\",\"error\":{\"type\":\"permission_error\",\n            \"message\":\"The requested model is not approved for this gateway.\"}}</set-body>\n        </return-response>\n      </when>\n    </choose>\n\n    <!-- 5.3.3 Per-user token rate + monthly quota -->\n    <llm-token-limit counter-key=\"@(&quot;user:&quot; + (string)context.Variables[&quot;userOid&quot;])\"\n        tokens-per-minute=\"30000\" token-quota=\"5000000\" token-quota-period=\"Monthly\"\n        estimate-prompt-tokens=\"true\" retry-after-header-name=\"Retry-After\"\n        remaining-tokens-header-name=\"x-user-tpm-remaining\"\n        remaining-quota-tokens-header-name=\"x-user-quota-remaining\"\n        tokens-consumed-header-name=\"x-tokens-consumed\" />\n\n    <!-- 5.3.4 Low-cardinality token metric + metadata-only trace -->\n    <llm-emit-token-metric namespace=\"EnterpriseAI\">\n      <dimension name=\"API ID\" />\n      <dimension name=\"Backend ID\" />\n    </llm-emit-token-metric>\n    <trace source=\"ai-gateway-mvp\" severity=\"information\">\n      <message>@(\"ai_gateway_request\")</message>\n      <metadata name=\"correlationId\" value=\"@(context.RequestId.ToString())\" />\n      <metadata name=\"userOid\" value=\"@((string)context.Variables[&quot;userOid&quot;])\" />\n      <metadata name=\"model\" value=\"@((string)context.Variables[&quot;requestedModel&quot;])\" />\n    </trace>\n\n    <!-- 5.3.5 API-key backend call to Foundry (cross-tenant resource; managed\n         identity is not possible, so the key is injected from a Key Vault-\n         backed named value instead of being forwarded from the client) -->\n    <set-backend-service backend-id=\"foundry-claude-pilot\" />\n    <set-header name=\"Ocp-Apim-Subscription-Key\" exists-action=\"delete\" />\n    <set-header name=\"x-api-key\" exists-action=\"override\">\n      <value>{{foundry-api-key}}</value>\n    </set-header>\n\n    <!-- 5.4 Streaming: forward Anthropic headers unchanged -->\n    <set-header name=\"anthropic-version\" exists-action=\"skip\">\n      <value>@(context.Request.Headers.GetValueOrDefault(\"anthropic-version\",\"\"))</value>\n    </set-header>\n    <set-header name=\"anthropic-beta\" exists-action=\"skip\">\n      <value>@(context.Request.Headers.GetValueOrDefault(\"anthropic-beta\",\"\"))</value>\n    </set-header>\n  </inbound>\n  <backend>\n    <!-- 5.4 Streaming: no SSE buffering, generous forward timeout for long-running calls -->\n    <forward-request timeout=\"{{backend-forward-timeout}}\" buffer-response=\"false\" />\n  </backend>\n  <outbound>\n    <base />\n  </outbound>\n  <on-error>\n    <base />\n  </on-error>\n</policies>\n",
            "$fxv#1": "<!--\n  Claude Governance MVP — GET /v1/models operation policy\n  Optional client-discovery endpoint. Does not call the Foundry backend\n  (Anthropic has no public /v1/models list API) — it simply returns a\n  static JSON document describing the models approved for this\n  gateway ({{approved-model-name}}), still gated by the same Entra token\n  validation used on /v1/messages so it is not an unauthenticated probe.\n-->\n<policies>\n  <inbound>\n    <base />\n    <validate-azure-ad-token tenant-id=\"{{entra-tenant-id}}\"\n        header-name=\"Authorization\" failed-validation-httpcode=\"401\"\n        failed-validation-error-message=\"Missing or invalid access token.\">\n      <audiences>\n        <audience>{{gateway-api-client-id}}</audience>\n      </audiences>\n      <client-application-ids>\n        <application-id>{{cowork-client-id}}</application-id>\n      </client-application-ids>\n      <required-claims>\n        <claim name=\"scp\" match=\"any\" separator=\" \">\n          <value>Inference.Invoke</value>\n        </claim>\n      </required-claims>\n    </validate-azure-ad-token>\n    <return-response>\n      <set-status code=\"200\" reason=\"OK\" />\n      <set-header name=\"Content-Type\" exists-action=\"override\">\n        <value>application/json</value>\n      </set-header>\n      <set-body>@{\n        var approved = &quot;{{approved-model-name}}&quot;.Split(',');\n        var models = new JArray();\n        foreach (var m in approved) {\n          models.Add(new JObject(\n            new JProperty(&quot;id&quot;, m),\n            new JProperty(&quot;object&quot;, &quot;model&quot;)\n          ));\n        }\n        return new JObject(\n          new JProperty(&quot;object&quot;, &quot;list&quot;),\n          new JProperty(&quot;data&quot;, models)\n        ).ToString();\n      }</set-body>\n    </return-response>\n  </inbound>\n  <backend>\n    <base />\n  </backend>\n  <outbound>\n    <base />\n  </outbound>\n  <on-error>\n    <base />\n  </on-error>\n</policies>\n"
          },
          "resources": [
            {
              "type": "Microsoft.ApiManagement/service/namedValues",
              "apiVersion": "2024-05-01",
              "name": "[format('{0}/{1}', parameters('apimServiceName'), 'foundry-api-key')]",
              "properties": {
                "displayName": "foundry-api-key",
                "secret": true,
                "keyVault": {
                  "secretIdentifier": "[format('{0}secrets/{1}', parameters('keyVaultUri'), parameters('foundryApiKeySecretName'))]"
                }
              }
            },
            {
              "type": "Microsoft.ApiManagement/service/namedValues",
              "apiVersion": "2024-05-01",
              "name": "[format('{0}/{1}', parameters('apimServiceName'), 'approved-model-name')]",
              "properties": {
                "displayName": "approved-model-name",
                "value": "[parameters('approvedModelName')]",
                "secret": false
              }
            },
            {
              "type": "Microsoft.ApiManagement/service/namedValues",
              "apiVersion": "2024-05-01",
              "name": "[format('{0}/{1}', parameters('apimServiceName'), 'backend-forward-timeout')]",
              "properties": {
                "displayName": "backend-forward-timeout",
                "value": "[string(parameters('backendForwardTimeoutSeconds'))]",
                "secret": false
              }
            },
            {
              "type": "Microsoft.ApiManagement/service/backends",
              "apiVersion": "2024-05-01",
              "name": "[format('{0}/{1}', parameters('apimServiceName'), 'foundry-claude-pilot')]",
              "properties": {
                "protocol": "http",
                "url": "[parameters('foundryEndpointUrl')]",
                "tls": {
                  "validateCertificateChain": true,
                  "validateCertificateName": true
                }
              }
            },
            {
              "type": "Microsoft.ApiManagement/service/apis",
              "apiVersion": "2024-05-01",
              "name": "[format('{0}/{1}', parameters('apimServiceName'), 'anthropic-messages-api')]",
              "properties": {
                "displayName": "Anthropic Messages API (Claude Governance Gateway)",
                "description": "Governed passthrough of the Anthropic Messages API to the Microsoft Foundry-hosted Claude model, fronted by Entra ID token validation and per-user quotas.",
                "path": "v1",
                "protocols": [
                  "https"
                ],
                "subscriptionRequired": false
              }
            },
            {
              "type": "Microsoft.ApiManagement/service/apis/operations",
              "apiVersion": "2024-05-01",
              "name": "[format('{0}/{1}/{2}', parameters('apimServiceName'), 'anthropic-messages-api', 'post-messages')]",
              "properties": {
                "displayName": "Create a Message",
                "method": "POST",
                "urlTemplate": "/messages",
                "description": "Anthropic Messages API passthrough, governed by Entra token validation, model allowlist, and per-user token quota."
              },
              "dependsOn": [
                "[resourceId('Microsoft.ApiManagement/service/apis', parameters('apimServiceName'), 'anthropic-messages-api')]"
              ]
            },
            {
              "condition": "[parameters('includeModelsOperation')]",
              "type": "Microsoft.ApiManagement/service/apis/operations",
              "apiVersion": "2024-05-01",
              "name": "[format('{0}/{1}/{2}', parameters('apimServiceName'), 'anthropic-messages-api', 'get-models')]",
              "properties": {
                "displayName": "List Models (discovery)",
                "method": "GET",
                "urlTemplate": "/models",
                "description": "Optional client-discovery endpoint listing the models approved for this gateway."
              },
              "dependsOn": [
                "[resourceId('Microsoft.ApiManagement/service/apis', parameters('apimServiceName'), 'anthropic-messages-api')]"
              ]
            },
            {
              "type": "Microsoft.ApiManagement/service/apis/operations/policies",
              "apiVersion": "2024-05-01",
              "name": "[format('{0}/{1}/{2}/{3}', parameters('apimServiceName'), 'anthropic-messages-api', 'post-messages', 'policy')]",
              "properties": {
                "format": "xml",
                "value": "[variables('$fxv#0')]"
              },
              "dependsOn": [
                "[resourceId('Microsoft.ApiManagement/service/backends', parameters('apimServiceName'), 'foundry-claude-pilot')]",
                "[resourceId('Microsoft.ApiManagement/service/apis/operations', parameters('apimServiceName'), 'anthropic-messages-api', 'post-messages')]",
                "[resourceId('Microsoft.ApiManagement/service/namedValues', parameters('apimServiceName'), 'approved-model-name')]",
                "[resourceId('Microsoft.ApiManagement/service/namedValues', parameters('apimServiceName'), 'backend-forward-timeout')]",
                "[resourceId('Microsoft.ApiManagement/service/namedValues', parameters('apimServiceName'), 'foundry-api-key')]"
              ]
            },
            {
              "condition": "[parameters('includeModelsOperation')]",
              "type": "Microsoft.ApiManagement/service/apis/operations/policies",
              "apiVersion": "2024-05-01",
              "name": "[format('{0}/{1}/{2}/{3}', parameters('apimServiceName'), 'anthropic-messages-api', 'get-models', 'policy')]",
              "properties": {
                "format": "xml",
                "value": "[variables('$fxv#1')]"
              },
              "dependsOn": [
                "[resourceId('Microsoft.ApiManagement/service/apis/operations', parameters('apimServiceName'), 'anthropic-messages-api', 'get-models')]",
                "[resourceId('Microsoft.ApiManagement/service/namedValues', parameters('apimServiceName'), 'approved-model-name')]"
              ]
            },
            {
              "type": "Microsoft.ApiManagement/service/products",
              "apiVersion": "2024-05-01",
              "name": "[format('{0}/{1}', parameters('apimServiceName'), 'claude-pilot')]",
              "properties": {
                "displayName": "Claude Desktop Pilot",
                "description": "Product grouping the governed Anthropic Messages API for the Claude Desktop pilot group.",
                "subscriptionRequired": false,
                "state": "published"
              }
            },
            {
              "type": "Microsoft.ApiManagement/service/products/apis",
              "apiVersion": "2024-05-01",
              "name": "[format('{0}/{1}/{2}', parameters('apimServiceName'), 'claude-pilot', 'anthropic-messages-api')]",
              "dependsOn": [
                "[resourceId('Microsoft.ApiManagement/service/apis', parameters('apimServiceName'), 'anthropic-messages-api')]",
                "[resourceId('Microsoft.ApiManagement/service/products', parameters('apimServiceName'), 'claude-pilot')]"
              ]
            }
          ],
          "outputs": {
            "messagesApiId": {
              "type": "string",
              "metadata": {
                "description": "Resource ID of the anthropic-messages-api API."
              },
              "value": "[resourceId('Microsoft.ApiManagement/service/apis', parameters('apimServiceName'), 'anthropic-messages-api')]"
            },
            "backendId": {
              "type": "string",
              "metadata": {
                "description": "Backend ID used by the policy set-backend-service step."
              },
              "value": "foundry-claude-pilot"
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Resources/deployments', 'deploy-apim')]",
        "[resourceId('Microsoft.Resources/deployments', 'deploy-keyvault')]"
      ]
    }
  ],
  "outputs": {
    "apimGatewayUrl": {
      "type": "string",
      "metadata": {
        "description": "APIM gateway URL to use as the Claude Desktop / Claude Code base URL until a custom domain is configured."
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'deploy-apim'), '2022-09-01').outputs.apimGatewayUrl.value]"
    },
    "apimPrincipalId": {
      "type": "string",
      "metadata": {
        "description": "APIM system-assigned managed identity principal ID."
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'deploy-apim'), '2022-09-01').outputs.apimPrincipalId.value]"
    },
    "backendId": {
      "type": "string",
      "metadata": {
        "description": "Backend ID used for the Foundry passthrough (for verification)."
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'deploy-apim-policy'), '2022-09-01').outputs.backendId.value]"
    },
    "logAnalyticsWorkspaceId": {
      "type": "string",
      "metadata": {
        "description": "Log Analytics workspace resource ID (for KQL queries / verification)."
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'deploy-observability'), '2022-09-01').outputs.logAnalyticsWorkspaceId.value]"
    },
    "keyVaultName": {
      "type": "string",
      "metadata": {
        "description": "Key Vault name holding the Foundry API key secret. Run `az keyvault secret set --vault-name <this> --name foundry-api-key --value \"<key>\"` after deployment."
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'deploy-keyvault'), '2022-09-01').outputs.keyVaultName.value]"
    },
    "keyVaultUri": {
      "type": "string",
      "metadata": {
        "description": "Key Vault URI."
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'deploy-keyvault'), '2022-09-01').outputs.keyVaultUri.value]"
    }
  }
}