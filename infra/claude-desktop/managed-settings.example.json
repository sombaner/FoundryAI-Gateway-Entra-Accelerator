{
  "inference": {
    "provider": "gateway",
    "baseUrl": "https://<gateway-name>",
    "credential": {
      "kind": "interactive",
      "authFlow": "browser",
      "oidc": {
        "clientId": "<client-id>",
        "issuer": "<issuer>,
        "bearerTokenType": "access_token",
        "scopes": "api://<id>/Inference.Invoke",
        "appendOfflineAccess": true
      }
    }
  }
}
