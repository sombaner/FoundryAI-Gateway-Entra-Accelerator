{
  "inference": {
    "provider": "gateway",
    "baseUrl": "https://<apim-service-name>.azure-api.net",
    "credential": {
      "kind": "interactive",
      "authFlow": "browser",
      "oidc": {
        "clientId": "<cowork-client-app-id>",
        "issuer": "https://login.microsoftonline.com/<tenant-id>/v2.0",
        "bearerTokenType": "access_token",
        "scopes": "api://<gateway-api-app-id>/Inference.Invoke",
        "appendOfflineAccess": true
      }
    }
  }
}