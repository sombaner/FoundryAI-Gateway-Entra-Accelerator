# Reference values only. Never store API keys or other secrets in this file or source control.
# Copy this file to `infra/azure.env` and fill in real values for your deployment.
# `infra/azure.env` is gitignored — the scripts and *.bicepparam files in this repo
# read these variables via os.environ / readEnvironmentVariable() instead of hardcoding them.

# --- Azure deployment target -------------------------------------------------
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=rg-claude-governance
AZURE_LOCATION=eastus2

# --- Microsoft Entra ID (infra/entra) ----------------------------------------
AZURE_TENANT_ID=<your-entra-tenant-id>
GATEWAY_API_CLIENT_ID=<AI-Gateway-API-app-registration-client-id>
COWORK_CLIENT_ID=<Claude-Cowork-Client-app-registration-client-id>
GATEWAY_SCOPE_NAME=Inference.Invoke
# Comma-separated (no spaces) Entra object IDs seeded into the pilot security group.
PILOT_MEMBER_OBJECT_IDS=<object-id-1>,<object-id-2>

# --- APIM AI Gateway ----------------------------------------------------------
GATEWAY_URL=https://<apim-service-name>.azure-api.net
APIM_PUBLISHER_NAME=<your-org> IT Governance
APIM_PUBLISHER_EMAIL=admin@<your-tenant>.onmicrosoft.com

# --- Microsoft Foundry / Anthropic backend ------------------------------------
# Existing, pre-provisioned Anthropic Messages API base URL, must end in /v1.
FOUNDRY_ENDPOINT_URL=https://<foundry-resource>.services.ai.azure.com/anthropic/v1
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_MODEL=claude-opus-4-5
# Comma-separated (no spaces) allowlist of model deployment names the gateway accepts.
APPROVED_MODELS=claude-opus-5,claude-opus-4-5,claude-opus-4-6,claude-sonnet-4-6
FOUNDRY_API_KEY_SECRET_NAME=foundry-api-key